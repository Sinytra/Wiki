{
  "name": "moddedmc-wiki",
  "private": true,
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build": "turbo run build --filter=!previewer",
    "dev": "turbo run dev --filter=!previewer",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "format": "prettier --write \"**/*.{ts,tsx}\""
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.10.11",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.19.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.3.0",
      "@types/react-dom": "19.3.0",
      "zod@^4": "~4.3.6",
      "@xmldom/xmldom@<0.9.12": "^0.9.12",
      "katex@<0.18.2": "^0.19.1",
      "postcss@<8.5.23": "^8.5.26",
      "postcss-selector-parser@<6.1.5": "^6.1.5",
      "toml@<5.0.1": "^5.0.1",
      "uuid@<11.1.1": "^11.1.1"
    }
  }
}
